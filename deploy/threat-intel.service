[Unit]
Description=Threat Intelligence Platform
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/threat-intel-platform
Environment="FLASK_HOST=127.0.0.1"
Environment="FLASK_PORT=5000"
EnvironmentFile=-/opt/threat-intel-platform/.env
ExecStart=/usr/bin/python3 /opt/threat-intel-platform/app.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=threat-intel

[Install]
WantedBy=multi-user.target
