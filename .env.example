# Threat Intelligence Platform Configuration
# Copy this to .env and fill in your values

# Flask
SECRET_KEY=change-this-to-a-random-secret-key
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Tor / SOCKS5 (for dark web scraping)
# Start tor with: apt install tor && systemctl enable --now tor
TOR_ENABLED=true
TOR_PROXY=socks5://127.0.0.1:9050
TOR_CONTROL=9051

# Telegram (optional - for live monitoring via MTProto)
# Get API credentials at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# HaveIBeenPwned API Key (optional - enables full breach data)
# Get key at https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# OTX API Key (optional)
# Get key at https://otx.alienvault.com/api
OTX_API_KEY=
