# Threat Intelligence Platform Configuration
# Copy this to .env and fill in your values

# Flask
SECRET_KEY=change-this-to-a-random-secret-key
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Telegram (optional - for live monitoring)
# Get API credentials at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# HaveIBeenPwned API Key (optional - enables full breach data)
# Get key at https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# OTX API Key (optional)
OTX_API_KEY=
